 ```c++\n   string a;\n   ```\n2. \u521d\u59cb\u5316\u8d4b\u503c:\n   ```c++\n   string a='Hello,World!';\n   ```\n3. \u53ef\u4f7f\u7528\u53e6\u4e00\u4e2astring\u521d\u59cb\u5316\u8fd9\u4e2a\u5b57\u7b26\u4e32;\n   ```c++\n    string a=b;\n   ```\n4. string\u7684\u5199\u5165:\n   ```c++\n   cin>>a;\n   getline(cin,a);\n   //\u524d\u8005\u5199\u5165\u5230\u7a7a\u683c\u5c31\u505c\u6b62,\u540e\u8005\u5199\u5165\u5230\\n\u505c\u6b62\u5199\u5165;\n   ```\n5. \u4f7f\u7528\u90e8\u5206\u5b57\u7b26\u4e32\u521d\u59cb\u5316\u8be5\u5b57\u7b26\u4e32:\n   ```c++\n    a=b.substr(0,5);\n   //\u610f\u601d\u662f\u4eceb\u4e2d\u4e0b\u6807\u4e3a0\u5f00\u59cb\u627e\u4e94\u4e2a\u957f\u5ea6\u7684\u5b57\u7b26\u521d\u59cb\u5316a,\u5982\u679c\u4e0d\u5199\u957f\u5ea6\u9ed8\u8ba4\u5230\u672b\u5c3e;\n   ```\n6. \u4f7f\u7528char\u7c7b\u578b\u6570\u7ec4\u521d\u59cb\u5316\u5b57\u7b26\u4e32:\n   ```c++\n   char b='LuoTianYi';\n   string a(b);\n   //\u7136\u540ea\u5c31\u7b49\u4e8eb\u7684\u5185\u5bb9\u4e86;\n   ```\n7. \u4f7f\u7528\u91cd\u590d\u5b57\u7b26\u521d\u59cb\u5316\u5b57\u7b26\u4e32:\n   ```c++\n    string a(5,'A');\n   //\u610f\u601d\u662f\u628aa\u5b57\u7b26\u4e32\u5f00\u59cb\u4e94\u4e2a\u957f\u5ea6\u7528'A'\u586b\u5145;\n   ```\n8. \u8f93\u51fa:\n   ```c++\n   cout<<a;\n   ```\n## string\u57fa\u672c\u64cd\u4f5c\n1. string\u548cchar\u7684\u76f8\u4e92\u8f6c\u6362\uff08c_str\uff09\n   ```c++\n   char a[100];\n   scanf('%s',&a);\n   string b(a)//\u5efa\u7acbstring\u7c7b\u578bb\uff0c\u628achar\u7c7b\u578ba\u7ed9string\u7c7b\u578bb\u4f7f\u7528;\n   printf('%s',b.c_str())//\u628astring\u7c7b\u578b\u8f6c\u6362\u4e3aconstchar\u7c7b\u578b\u8f93\u51fa\uff0c\u56e0\u4e3aprintf\u4e0d\u80fd\u8bc6\u522b\u8f93\u51fastring\u7c7b\u578b\n   ```\n2. \u5b57\u7b26\u4e32\u7684\u957f\u5ea6\u83b7\u53d6\uff08size\u6216length\uff09\n   ```c++\n   string a;\n   int len=a.size();//\u4f18\u5148\u7528\u8fd9\u4e2a\uff0cstl\u4e2d\u81ea\u5e26\u7684\u5185\u5bb9\uff0c\u6240\u6709stl\u5bb9\u5668\u90fd\u53ef\u4ee5\u4f7f\u7528\n   int len1=a.length();//\u4e0e\u4e0a\u8005\u5b8c\u5168\u7b49\u4ef7\n   ```\n3. \u62fc\u63a5\u5b57\u7b26\u4e32\uff08+\u6216append\u6216+=\uff09\n   ```c++\n   string a='Hello';\n   string b='World!';\n   string end1=a+','+b;//\u76f4\u89c2\u65b9\u4fbf\uff0c\u4f46\u4f1a\u521b\u9020\u4e34\u65f6\u53d8\u91cf\u7528\u6765\u50a8\u5b58\uff0c\u5360\u7528\u7a7a\u95f4\u8f83\u591a\n   string end2=a.append(',').append(b);//\u4e0d\u63a8\u8350\uff0c\u4e0d\u591f\u76f4\u89c2\u53ef\u8bfb\uff0c\u5982\u679c\u9700\u8981\u5728\u539f\u5b57\u7b26\u4e32\u4e0a\u52a0\u53ef\u4ee5\u76f4\u63a5+=\uff0c\u4f1a\u52a0\u5728\u5b57\u7b26\u4e32\u6700\u540e\u9762\n   ```\n4. \u5b57\u7b26\u4e32\u5185\u5bb9\u67e5\u627e\uff08find\uff09\n   ```c++\n   string a=\u201cHello\uff0cWorld\uff01\u201d;//01234 5 678910 11\n   int fd=a.find('World\uff01');//\u610f\u4e3a\u5bfb\u627eWorld\uff01\u7684\u4f4d\u7f6e\uff0c\u6ce8\u610f\u8fd9\u91ccfind\u627e\u5230\u540e\u4f1a\u7ed9fd\u8d4b\u503c\u4e3a\u8fd9\u4e2a\u5b50\u5b57\u7b26\u4e32\u5728\u539f\u5b57\u7b26\u4e32\u4e2d\u7684\u521d\u59cb\u4f4d\u7f6e\uff0c\u5373W\u7684\u4e0b\u68076\n   //\u89c6\u9891\u91cc\u9762\u51fa\u73b0\u4e2a7\u56e0\u4e3a\u4ed6\u6bd4\u6211\u7684\u591a\u4e86\u4e2a\u7a7a\u683c\u3002", "top": 0, "createdAt": 1793602964, "style": "", "script": "", "head": "", "ogImage": "https://avatars.githubusercontent.com/u/133500477?v=4&size=64", "createdDate": "2026-11-02", "dateLabelColor": "#1f883d"}}, "singeListJson": {}, "labelColorDict": {"accessibility": "#f143ab", "bug": "#d73a4a", "documentation": "#0075ca", "duplicate": "#cfd3d7", "enhancement": "#a2eeef", "good first issue": "#7057ff", "help wanted": "#008672", "invalid": "#e4e669", "question": "#d876e3", "wontfix": "#ffffff"}, "displayTitle": "\u7199\u7199\u6d1b\u53f6\u77e5\u79cb\u306e\u4e2a\u4eba\u535a\u5ba2", "faviconUrl": "https://avatars.githubusercontent.com/u/133500477?v=4&size=64", "ogImage": "https://avatars.githubusercontent.com/u/133500477?v=4&size=64", "primerCSS": "<link href='https://mirrors.sustech.